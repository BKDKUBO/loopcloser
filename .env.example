# API settings for local runs (copy to api/.env). Never commit real values.
APP_ENV=local
DEMO_MODE=true            # labeled role switcher for judges; Firebase Auth stays on. false = real accounts only
STORAGE_BACKEND=memory    # memory or firestore (use the emulator locally)
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_SENSITIVE_PER_MINUTE=10
ESCALATE_AFTER_FAILED_CONTACTS=3
# Optional locally. In production this comes from Secret Manager only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
