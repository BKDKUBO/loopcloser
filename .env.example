# API settings for local runs (copy to api/.env). Never commit real values.
APP_ENV=local
DEMO_MODE=true            # labeled role switcher for judges; Firebase Auth stays on. false = real accounts only
STORAGE_BACKEND=memory    # memory or firestore (use the emulator locally)
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_SENSITIVE_PER_MINUTE=10
ESCALATE_AFTER_FAILED_CONTACTS=3
# AI drafts. off = deterministic mock (default). Production uses vertex with the Cloud Run service account.
GEMINI_BACKEND=off        # off | vertex | api_key
GEMINI_MODEL=gemini-3.8-flash
VERTEX_PROJECT=           # e.g. loopcloser-bkdkubo (needs local ADC)
VERTEX_LOCATION=global    # gemini-3.8-flash is served from global, not asia-southeast1
GEMINI_API_KEY=           # only with GEMINI_BACKEND=api_key, local experiments
