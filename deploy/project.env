# LoopCloser's own Google Cloud / Firebase project. Single place to change it.
# It is NOT the InvoiceSentinel project. Scripts and CI refuse that id.
PROJECT_ID=loopcloser-bkdkubo      # placeholder until the project is created; ids are global, may need a suffix
REGION=asia-southeast1
ORG_ID=834340325006                # mmocanaiii-org
FIRESTORE_DATABASE="(default)"     # only the (default) database gets the Firestore free tier
# Firebase Hosting default site = project id -> https://${PROJECT_ID}.web.app
FORBIDDEN_PROJECT_IDS="gen-lang-client-0252871691"
